# Origem(ns) do app web que chamam a API com cookie httpOnly (separadas por virgula).
# Em producao, app e API devem estar no mesmo site (ex.: app.seudominio e api.seudominio) e em HTTPS.
WEB_ORIGIN=http://localhost:4200
