NODE_ENV=dev
PORT=3030
DATABASE_URL=postgresql://sonara:sonara@localhost:55432/sonara
JWT_SECRET=troque-por-um-segredo-longo
EXPIRES_IN=15m
EXPIRES_IN_REFRESH_TOKEN=30d
# Ed25519 (base64url). Gere com: npm run keys
LICENSE_PRIVATE_KEY=
